__pycache__/
*.pyc
.env
athena.db
# Timestamped safety copies (athena.backup-YYYYmmdd-HHMMSS.db). Ignored because
# the commit flow here uses `git add -A`, and a 232MB database would otherwise
# be committed by an unrelated change.
athena.backup-*.db
qdrant_data/
voices/
backend/data/
.pytest_cache/
node_modules/
dist/
.venv/
venv/

# Dev-server logs -- these have floated untracked across several sessions and
# are one `git add .` away from being committed.
#
# A PATTERN, not the four filenames that used to be listed here. The
# enumeration said server.out.log / server.err.log / vite.out.log /
# vite.err.log, and `backend.log` was not among them, so a `git add -A` swept it
# into a commit -- exactly the failure §17.15 describes, arriving in a gitignore.
# The property is "a log file", and *.log expresses it; a list of names cannot
# be consulted about the next one.
*.log
# Chat-history export dropped into the tree while working; not repo content.
athena-docs/

# Raw session transcripts: 54MB each, superseded by the curated docs,
# and they contain verbatim pasted credentials. Never commit these.
docs/Context/
