# ---- LLM keys (both free, no credit card) ----
# Gemini: https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=your_gemini_key_here
# Groq:   https://console.groq.com -> "API Keys"
GROQ_API_KEY=your_groq_key_here

# ---- Auth ----
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Storage ----
DATABASE_URL=sqlite:///./athena.db
# QDRANT_PATH, RESOURCES_DIR, REPO_CLONE_ROOT: leave unset to use the default
# per-OS app-data directory (via platformdirs), outside this repo's own tree.
# Only set one of these if you specifically need it somewhere else.
